# ===== Supply Chain Disruption & Replanning System =====
# Copy to .env and adjust. Defaults work out-of-the-box on local SQLite.

# ---- App ----
APP_NAME="Supply Chain Disruption & Replanning System"
APP_ENV=development            # development | production
APP_DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# ---- Database ----
# SQLite by default for instant local runs. Set a Postgres URL for production.
DATABASE_URL=sqlite:///./supply_chain.db
# Example PostgreSQL (used together with Docker Compose):
# DATABASE_URL=postgresql+psycopg2://scdemo:scdemo@localhost:5432/supplychain

# ---- LangGraph checkpoint store ----
# blank => MemorySaver (in-process). Set to a Postgres URL for durable checkpoints.
CHECKPOINT_DB_URL=

# ---- Redis (optional; in-memory cache used if blank) ----
REDIS_URL=

# ---- Auth ----
# Generate a strong value in production (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Seed/demo ----
# When true the app seeds an admin user and loads demo data on first start.
SEED_DEMO_DATA=true
DATASET_CSV=data/supply_chain_dataset.csv
NUM_DATASET_RECORDS=12000

# ---- Human-in-the-loop thresholds ----
# Recovery plans above either threshold are routed to the Approval Agent.
APPROVAL_COST_THRESHOLD=25000.0
APPROVAL_DELAY_THRESHOLD_DAYS=7
